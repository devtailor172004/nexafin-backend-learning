# Backend base URL. Leave empty when using the Vite dev proxy (default).
# Set this when the built app is served from a different origin than the API,
# and add that origin to the backend's CORS_ORIGINS environment variable.
VITE_API_BASE_URL=

# Dev proxy target for /api requests (defaults to http://localhost:3000)
VITE_API_TARGET=http://localhost:3000
