# =============================================================================
# SecurePay Lab — environment template (Phase 3)
# Copy to `.env` and fill in. Values marked REQUIRED phase 3 must be set for the
# hosted-database + real-payment setup.
# =============================================================================

# -----------------------------------------------------------------------------
# App / auth
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CHECKOUT_PAGE_URL=http://localhost:3000/pay
# Comma separated. Only needed when the frontend is served from another origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# REQUIRED phase 3 — sign JWTs (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# Database — managed Postgres (Neon)                                        [REQUIRED phase 3]
# -----------------------------------------------------------------------------
# Neon connection string, e.g.
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Force the dialect (auto-detected from DATABASE_URL when omitted).
DB_DIALECT=postgres
# TLS: DB_SSL=false to disable, DB_SSL_STRICT=true to enforce full verification.
DB_SSL=true
DB_SSL_STRICT=false
# Run sequelize.sync() on boot. Must be "true" to auto-create schema in production.
DB_AUTO_SYNC=true
DB_POOL_MAX=5
DB_POOL_MIN=0

# Legacy self-managed MySQL (only used when DATABASE_URL is empty)
# DB_DATABASE=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_DIALECT=mysql

# -----------------------------------------------------------------------------
# Payments — Pine Labs
# -----------------------------------------------------------------------------
# Real Pine Labs: point at the gateway (test or production).
#   PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in
# Sandbox: leave the app's own sandbox in place (see PAYMENT_SANDBOX_ENABLED).
PINELABS_BASE_URL=http://localhost:3000/sandbox/pinelabs
# REQUIRED for real payments — Pine Labs merchant credentials.
# PINE_LABS_CLIENT_ID=
# REQUIRED — also used to verify signed provider webhooks (fail-closed).
PINE_LABS_CLIENT_SECRET=

# Built-in Pine Labs-compatible SANDBOX gateway (never mounted in production).
PAYMENT_SANDBOX_ENABLED=true
SANDBOX_APP_URL=http://localhost:3000
# Optional: override the webhook target and delay (ms).
# SANDBOX_WEBHOOK_URL=
SANDBOX_WEBHOOK_DELAY_MS=600

# Settlements: minimum age (hours) a PROCESSED payment must reach before it can settle.
SETTLEMENT_MIN_AGE_HOURS=0

# -----------------------------------------------------------------------------
# KYC verification vendor (PAN / CIN / GST / Bank)                          [REQUIRED for KYC]
# -----------------------------------------------------------------------------
# VERIFICATION_CLIENT_ID=
# VERIFICATION_CLIENT_SECRET=
# PAN_VERIFICATION_URL=
# CIN_VERIFICATION_URL=
# GST_ADVANCE_VERIFICATION_URL=
# BANK_VERIFICATION_URL=

# -----------------------------------------------------------------------------
# DigiLocker (Aadhaar)
# -----------------------------------------------------------------------------
# DIGILOCKER_VERIFY_ACCOUNT_URL=
# DIGILOCKER_INITIATE_SESSION_URL=
# DIGILOCKER_REDIRECT_URI=
# DIGILOCKER_SUCCESS_URI=
# DIGILOCKER_GET_REFERENCE_URL=
# DIGILOCKER_FETCH_AADHAAR_URL=

# -----------------------------------------------------------------------------
# Cloudflare R2 — KYC document storage
# -----------------------------------------------------------------------------
# CLOUDFLARE_R2_ENDPOINT=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Email (SMTP) + SMS (OTP delivery)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
APP_NAME=SecurePay Lab
# MOBIROUTE_USERNAME=
# MOBIROUTE_PASSWORD=
# MOBIROUTE_ACCESS_KEY=
# MOBIROUTE_SENDER_ID=
# MOBIROUTE_API_URL=
# MOBIROUTE_TYPE=
# MOBIROUTE_ENTITY_ID=
# MOBIROUTE_TEMPLATE_ID=

# -----------------------------------------------------------------------------

# Misc
# -----------------------------------------------------------------------------
# IP_API_URL=
# Seed admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@securepay.local
SEED_ADMIN_PASSWORD=ChangeMeImmediatelyInProduction
SEED_ADMIN_MOBILE=9000000000
# Target for scripts/sandboxE2E.js
E2E_BASE_URL=http://127.0.0.1:3000
